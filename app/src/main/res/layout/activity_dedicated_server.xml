<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080808"
    android:id="@+id/main_view"
    tools:context="com.simplecoil.simplecoil.FullscreenActivity">

    <!-- This FrameLayout insets its children based on system windows using
         android:fitsSystemWindows; the CoordinatorLayout would handle that flag its own way. -->
    <FrameLayout
        android:id="@+id/connect_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        android:fitsSystemWindows="true"
        tools:ignore="UselessParent">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/server_coordinator"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Bottom padding is set to the player sheet's peek height, so no control hides behind it. -->
            <ScrollView
                android:id="@+id/server_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false">

                <RelativeLayout
                    android:id="@+id/server_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/version_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@+id/server_ip_tv"
                        android:layout_marginEnd="5dp"
                        android:layout_alignParentEnd="true"
                        android:text=""
                        android:textAppearance="@android:style/TextAppearance.Material.Small.Inverse" />

                    <TextView
                        android:id="@+id/server_ip_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="5dp"
                        android:text=""
                        android:textAppearance="@android:style/TextAppearance.Material.Small.Inverse" />

                    <Chronometer
                        android:id="@+id/game_timer_chronometer"
                        style="@android:style/TextAppearance.Material.Small.Inverse"
                        android:format="%s"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@+id/server_ip_tv"
                        android:layout_centerHorizontal="true"
                        android:layout_marginStart="15dp"/>

                    <TextView
                        android:id="@+id/game_countdown_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@+id/server_ip_tv"
                        android:layout_centerHorizontal="true"
                        android:layout_marginStart="15dp"
                        android:text=""
                        android:textAppearance="@android:style/TextAppearance.Material.Small.Inverse" />

                    <TextView
                        android:id="@+id/player_count_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_below="@+id/server_ip_tv"
                        android:layout_alignStart="@id/server_ip_tv"
                        android:textAppearance="@android:style/TextAppearance.Material.Small.Inverse" />

                    <TextView
                        android:id="@+id/game_limit_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignTop="@id/player_count_tv"
                        android:textAppearance="@android:style/TextAppearance.Material.Small.Inverse" />

                    <!-- The game's lifecycle: its phase on the divider, then Start → End → Reset in order. Only the
                         step to the next phase is enabled. The expanded player sheet stops below it. -->
                    <LinearLayout
                        android:id="@+id/phase_divider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/player_count_tv"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#444444" />

                        <TextView
                            android:id="@+id/game_status_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/dedicated_game_waiting"
                            android:textAppearance="@android:style/TextAppearance.Material.Small.Inverse" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#444444" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/phase_controls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/phase_divider"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/start_game_button"
                            style="@style/Widget.AppCompat.Button.Colored"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:maxLines="1"
                            android:textSize="12sp"
                            android:text="@string/dedicated_start_button" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="@string/dedicated_phase_arrow"
                            android:textColor="#AAAAAA"
                            android:textSize="24sp" />

                        <Button
                            android:id="@+id/end_game_button"
                            style="@style/Widget.AppCompat.Button.Colored"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:maxLines="1"
                            android:textSize="12sp"
                            android:enabled="false"
                            android:text="@string/dedicated_end_button" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="@string/dedicated_phase_arrow"
                            android:textColor="#AAAAAA"
                            android:textSize="24sp" />

                        <Button
                            android:id="@+id/reset_game_button"
                            style="@style/Widget.AppCompat.Button.Colored"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:maxLines="1"
                            android:textSize="12sp"
                            android:enabled="false"
                            android:text="@string/dedicated_reset_button" />
                    </LinearLayout>

                    <!-- Everything below sets up the game and the server. -->
                    <LinearLayout
                        android:id="@+id/settings_divider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/phase_controls"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="5dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#444444" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/dedicated_settings_label"
                            android:textAppearance="@android:style/TextAppearance.Material.Small.Inverse" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#444444" />
                    </LinearLayout>

                    <!-- Team and GPS modes as segmented controls, so every choice and the current one are in view; then the
                         limit and timer buttons in equal halves. -->
                    <LinearLayout
                        android:id="@+id/settings_buttons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/settings_divider"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/team_mode_label"
                            android:textAppearance="@android:style/TextAppearance.Material.Small.Inverse" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButtonToggleGroup
                                android:id="@+id/team_mode_group"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                app:selectionRequired="true"
                                app:singleSelection="true">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/team_mode_2teams_button"
                                    style="@style/ServerSegment"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/team_mode_2teams" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/team_mode_4teams_button"
                                    style="@style/ServerSegment"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/team_mode_4teams" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/team_mode_ffa_button"
                                    style="@style/ServerSegment"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/team_mode_ffa_short" />
                            </com.google.android.material.button.MaterialButtonToggleGroup>

                            <!-- Sets the one-off Sort apart from the modes. -->
                            <View
                                android:layout_width="1dp"
                                android:layout_height="32dp"
                                android:layout_marginStart="8dp"
                                android:layout_marginEnd="8dp"
                                android:background="#444444" />

                            <Button
                                android:id="@+id/sort_teams_button"
                                style="@style/Widget.AppCompat.Button.Colored"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:textSize="12sp"
                                android:text="@string/shuffle_teams_button" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/gps_mode_label"
                            android:textAppearance="@android:style/TextAppearance.Material.Small.Inverse" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/gps_mode_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/gps_mode_disabled_button"
                                style="@style/ServerSegment"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/gps_mode_disabled" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/gps_mode_teammate_button"
                                style="@style/ServerSegment"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/gps_mode_teammate" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/gps_mode_all_button"
                                style="@style/ServerSegment"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/gps_mode_all" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/game_limit_button"
                                style="@style/Widget.AppCompat.Button.Colored"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="5dp"
                                android:text="@string/game_limit_button" />

                            <Button
                                android:id="@+id/starting_timer_button"
                                style="@style/Widget.AppCompat.Button.Colored"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="5dp"
                                android:text="@string/starting_timer_button" />
                        </LinearLayout>
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/allow_join_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/settings_buttons"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="5dp"
                        android:text="@string/dedicated_allow_join"
                        android:textColor="#FFFFFF"/>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/only_server_settings_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/allow_join_switch"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:text="@string/dedicated_server_settings_only"
                        android:textColor="#FFFFFF"/>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/allow_choose_teams_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/only_server_settings_switch"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:text="@string/dedicated_allow_choose_teams"
                        android:textColor="#FFFFFF"/>
                </RelativeLayout>
            </ScrollView>

            <!-- The players: peeks into the space left below the controls; drag or tap the header to expand. -->
            <LinearLayout
                android:id="@+id/player_sheet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@drawable/bottom_sheet_background"
                app:behavior_peekHeight="@dimen/player_sheet_min_peek"
                app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

                <LinearLayout
                    android:id="@+id/player_sheet_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="?android:attr/selectableItemBackground">

                    <View
                        android:layout_width="36dp"
                        android:layout_height="4dp"
                        android:background="@drawable/bottom_sheet_handle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/player_sheet_title"
                        android:textColor="#CCCCCC"
                        android:textAppearance="@android:style/TextAppearance.Material.Small" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/player_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </LinearLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </FrameLayout>
</FrameLayout>
