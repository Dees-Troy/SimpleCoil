<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080808"
    android:id="@+id/main_view"
    tools:context="com.simplecoil.simplecoil.DedicatedServerActivity">

    <!-- Large screens in landscape (the Chromebook): the controls on the left, the scoreboard on
         the right. The same ids and view types as the portrait layout, so the screen's code (and
         its ViewBinding) is the same; hence this RelativeLayout around the panes. -->
    <RelativeLayout
        android:id="@+id/connect_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        android:fitsSystemWindows="true"
        tools:ignore="UselessParent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/version_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_alignParentEnd="true"
                        android:text=""
                        android:textAppearance="@android:style/TextAppearance.Material.Small.Inverse" />

                    <TextView
                        android:id="@+id/server_ip_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="5dp"
                        android:text=""
                        android:textAppearance="@android:style/TextAppearance.Material.Small.Inverse" />

                    <Chronometer
                        android:id="@+id/game_timer_chronometer"
                        style="@android:style/TextAppearance.Material.Small.Inverse"
                        android:format="%s"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@+id/server_ip_tv"
                        android:layout_centerHorizontal="true"
                        android:layout_marginStart="15dp"/>

                    <TextView
                        android:id="@+id/game_countdown_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignTop="@+id/server_ip_tv"
                        android:layout_centerHorizontal="true"
                        android:layout_marginStart="15dp"
                        android:text=""
                        android:textAppearance="@android:style/TextAppearance.Material.Small.Inverse" />

                    <TextView
                        android:id="@+id/player_count_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="10dp"
                        android:layout_below="@+id/server_ip_tv"
                        android:textAppearance="@android:style/TextAppearance.Material.Small.Inverse" />

                    <Button
                        android:id="@+id/team_mode_toggle_button"
                        style="@style/Widget.AppCompat.Button.Colored"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_below="@id/player_count_tv"
                        android:text="@string/team_mode_toggle_button" />

                    <TextView
                        android:id="@+id/game_limit_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_alignParentEnd="true"
                        android:layout_below="@id/server_ip_tv"
                        android:textAppearance="@android:style/TextAppearance.Material.Small.Inverse" />

                    <Button
                        android:id="@+id/game_limit_button"
                        style="@style/Widget.AppCompat.Button.Colored"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_alignParentEnd="true"
                        android:layout_below="@id/player_count_tv"
                        android:text="@string/game_limit_button" />

                    <Button
                        android:id="@+id/starting_timer_button"
                        style="@style/Widget.AppCompat.Button.Colored"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_alignParentEnd="true"
                        android:layout_below="@id/game_limit_button"
                        android:text="@string/starting_timer_button" />

                    <Button
                        android:id="@+id/gps_mode_button"
                        style="@style/Widget.AppCompat.Button.Colored"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_below="@id/team_mode_toggle_button"
                        android:text="@string/gps_mode_disabled" />

                    <!-- The game's lifecycle, below the settings: its phase, then Start → End → Reset in
                         order. Only the step to the next phase is enabled. -->
                    <View
                        android:id="@+id/phase_divider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_below="@id/gps_mode_button"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="5dp"
                        android:background="#444444" />

                    <TextView
                        android:id="@+id/game_status_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/phase_divider"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="8dp"
                        android:text="@string/dedicated_game_waiting"
                        android:textAppearance="@android:style/TextAppearance.Material.Small.Inverse" />

                    <LinearLayout
                        android:id="@+id/phase_controls"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/game_status_tv"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/start_game_button"
                            style="@style/Widget.AppCompat.Button.Colored"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:maxLines="1"
                            android:textSize="12sp"
                            android:text="@string/dedicated_start_button" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="@string/dedicated_phase_arrow"
                            android:textColor="#AAAAAA"
                            android:textSize="24sp" />

                        <Button
                            android:id="@+id/end_game_button"
                            style="@style/Widget.AppCompat.Button.Colored"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:maxLines="1"
                            android:textSize="12sp"
                            android:enabled="false"
                            android:text="@string/dedicated_end_button" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="@string/dedicated_phase_arrow"
                            android:textColor="#AAAAAA"
                            android:textSize="24sp" />

                        <Button
                            android:id="@+id/reset_game_button"
                            style="@style/Widget.AppCompat.Button.Colored"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:maxLines="1"
                            android:textSize="12sp"
                            android:enabled="false"
                            android:text="@string/dedicated_reset_button" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/allow_join_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/phase_controls"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="5dp"
                        android:text="@string/dedicated_allow_join"
                        android:textColor="#FFFFFF"/>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/only_server_settings_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/allow_join_switch"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:text="@string/dedicated_server_settings_only"
                        android:textColor="#FFFFFF"/>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/allow_choose_teams_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/only_server_settings_switch"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:text="@string/dedicated_allow_choose_teams"
                        android:textColor="#FFFFFF"/>
                </RelativeLayout>
            </ScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/player_list"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp" />
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
