<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#080808" >

    <LinearLayout
        android:id="@+id/layout_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp" >

        <TextView
            style="@style/DialogTitle"
            android:id="@+id/title_tv"
            android:text="@string/game_limit_title" />

        <TextView
            style="@style/DialogLabel"
            android:id="@+id/game_limit_time_label"
            android:labelFor="@+id/game_limit_time_et"
            android:text="@string/game_limit_time" />

        <EditText
            style="@style/DialogField"
            android:id="@+id/game_limit_time_et"
            android:importantForAutofill="no"
            android:digits="0123456789"
            android:maxLength="4"
            android:inputType="number" >

            <requestFocus />

        </EditText>

        <TextView
            style="@style/DialogLabel"
            android:id="@+id/game_limit_lives_label"
            android:labelFor="@+id/game_limit_lives_et"
            android:text="@string/game_limit_lives" />

        <EditText
            style="@style/DialogField"
            android:id="@+id/game_limit_lives_et"
            android:importantForAutofill="no"
            android:digits="0123456789"
            android:maxLength="4"
            android:inputType="number" />

        <TextView
            style="@style/DialogLabel"
            android:id="@+id/game_limit_score_label"
            android:labelFor="@+id/game_limit_score_et"
            android:text="@string/game_limit_score" />

        <EditText
            style="@style/DialogField"
            android:id="@+id/game_limit_score_et"
            android:importantForAutofill="no"
            android:digits="0123456789"
            android:maxLength="4"
            android:inputType="number" />

    </LinearLayout>

</ScrollView>
