<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        style="@style/DialogBody"
        android:id="@+id/team_ratio_instructions_tv"
        android:layout_marginTop="0dp"
        android:layout_width="match_parent"
        android:text="@string/team_ratio_instructions"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:id="@+id/team1_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="@string/team_ratio_team1"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <EditText
            style="@style/DialogField"
            android:id="@+id/team1_ratio_et"
            android:importantForAutofill="no"
            android:inputType="number"
            android:hint="@string/team_ratio_hint_two_teams" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/team2_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="@string/team_ratio_team2"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <EditText
            style="@style/DialogField"
            android:id="@+id/team2_ratio_et"
            android:importantForAutofill="no"
            android:inputType="number"
            android:hint="@string/team_ratio_hint_two_teams" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/team3_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="@string/team_ratio_team3"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <EditText
            style="@style/DialogField"
            android:id="@+id/team3_ratio_et"
            android:importantForAutofill="no"
            android:inputType="number"
            android:hint="@string/team_ratio_hint_four_teams" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/team4_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:text="@string/team_ratio_team4"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <EditText
            style="@style/DialogField"
            android:id="@+id/team4_ratio_et"
            android:importantForAutofill="no"
            android:inputType="number"
            android:hint="@string/team_ratio_hint_four_teams" />
    </LinearLayout>

</LinearLayout>
