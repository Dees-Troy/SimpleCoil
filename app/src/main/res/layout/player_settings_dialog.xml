<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#080808"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/layout_root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#080808"
        android:padding="10dp" >

        <TextView
            android:id="@+id/title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player_settings_title"
            android:textColor="#FFFFFF"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <View
            android:layout_width="fill_parent"
            android:layout_height="1dip"
            android:background="#444444" />

        <TextView
            android:id="@+id/health_title"
            android:labelFor="@+id/health_et"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/player_settings_health_title"
            android:textColor="#FFFFFF"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <EditText
            android:id="@+id/health_et"
            android:importantForAutofill="no"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:digits="0123456789"
            android:maxLength="3"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:backgroundTint="@color/colorPrimary"
            android:inputType="number" >
        <requestFocus />
        </EditText>

        <TextView
            android:id="@+id/shots_title"
            android:labelFor="@+id/reload_shots_et"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player_settings_reload_shots"
            android:textColor="#FFFFFF"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <EditText
            android:id="@+id/reload_shots_et"
            android:importantForAutofill="no"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:digits="0123456789"
            android:maxLength="3"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:backgroundTint="@color/colorPrimary"
            android:inputType="number" >
        </EditText>

        <TextView
            android:id="@+id/reload_time_title"
            android:labelFor="@+id/reload_time_et"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player_settings_reload_time"
            android:textColor="#FFFFFF"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <EditText
            android:id="@+id/reload_time_et"
            android:importantForAutofill="no"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:digits="0123456789"
            android:maxLength="5"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:backgroundTint="@color/colorPrimary"
            android:inputType="number" >
        </EditText>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/reload_on_empty_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#FFFFFF"
            android:text="@string/player_settings_reload_on_empty" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/manual_respawn_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#FFFFFF"
            android:text="@string/player_settings_manual_respawn" />

        <TextView
            android:id="@+id/spawn_time_title"
            android:labelFor="@+id/spawn_time_et"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player_settings_spawn_time"
            android:textColor="#FFFFFF"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <EditText
            android:id="@+id/spawn_time_et"
            android:importantForAutofill="no"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:digits="0123456789"
            android:maxLength="3"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:backgroundTint="@color/colorPrimary"
            android:inputType="number" >
        </EditText>

        <TextView
            android:id="@+id/respawn_shield_time_title"
            android:labelFor="@+id/respawn_shield_time_et"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player_settings_respawn_shield_time"
            android:textColor="#FFFFFF"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <EditText
            android:id="@+id/respawn_shield_time_et"
            android:importantForAutofill="no"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:digits="0123456789"
            android:maxLength="3"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:backgroundTint="@color/colorPrimary"
            android:inputType="number" >
        </EditText>

        <TextView
            android:id="@+id/damage_title"
            android:labelFor="@+id/damage_et"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player_settings_damage"
            android:textColor="#FFFFFF"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <EditText
            android:id="@+id/damage_et"
            android:importantForAutofill="no"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:digits="0123456789"
            android:maxLength="3"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:backgroundTint="@color/colorPrimary"
            android:inputType="number" >
        </EditText>

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/override_lives_limit_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#FFFFFF"
            android:text="@string/player_settings_override_lives" />

        <TextView
            android:id="@+id/lives_title"
            android:labelFor="@+id/lives_et"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player_settings_lives"
            android:textColor="#FFFFFF"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <EditText
            android:id="@+id/lives_et"
            android:importantForAutofill="no"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:digits="0123456789"
            android:maxLength="3"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:backgroundTint="@color/colorPrimary"
            android:inputType="number" >
        </EditText>

        <TextView
            android:id="@+id/shot_mode_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/player_settings_shot_modes_allowed"
            android:textColor="#FFFFFF"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/shot_mode_single"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:text="@string/shot_mode_single" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/shot_mode_burst3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:text="@string/shot_mode_burst3" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/shot_mode_auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:text="@string/shot_mode_auto" />

        <Button
            android:id="@+id/firing_mode_button"
            style="@style/Widget.AppCompat.Button.Colored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/firing_mode_outdoor_no_cone" />

        <Button
            android:id="@+id/recoil_setting_button"
            style="@style/Widget.AppCompat.Button.Colored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:visibility="gone"
            android:text="@string/player_settings_recoil_default" />

        <Button
            android:id="@+id/switch_team_button"
            style="@style/Widget.AppCompat.Button.Colored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:visibility="gone"
            android:text="@string/switch_team_button" />

        <Button
            android:id="@+id/kick_player_button"
            style="@style/Widget.AppCompat.Button.Colored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:visibility="gone"
            android:text="@string/kick_player_button" />

        <Button
            android:id="@+id/reset_defaults_button"
            style="@style/Widget.AppCompat.Button.Colored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/player_settings_reset" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/apply_to_all_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#FFFFFF"
            android:text="@string/player_settings_apply_to_all" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/apply_to_team_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#FFFFFF"
            android:text="@string/player_settings_apply_to_team" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/admin_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#FFFFFF"
            android:text="@string/player_settings_admin" />

    </LinearLayout>
</ScrollView>
