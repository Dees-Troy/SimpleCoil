<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#080808"
    android:padding="10dp" >

    <TextView
        style="@style/DialogTitle"
        android:id="@+id/title_tv"
        android:text="@string/qr_generate_title" />

    <TextView
        style="@style/DialogBody"
        android:id="@+id/explanation_tv"
        android:text="@string/qr_generate_explanation" />

    <TextView
        style="@style/DialogLabel"
        android:id="@+id/name_label_tv"
        android:text="@string/qr_player_name_label" />

    <EditText
        style="@style/DialogField"
        android:id="@+id/qr_player_name_et"
        android:autofillHints="username"
        android:inputType="textPersonName"
        android:hint="@string/qr_player_name_hint" />

</LinearLayout>
